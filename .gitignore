# ─────────────────────────────────────────────
# Karawaan — Git Ignore
# ─────────────────────────────────────────────

# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
build/

# Environment variables (NEVER commit these)
.env
.env.local
.env.production
.env.staging
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db

# OS files
.DS_Store
*.swp
*.swo

# Vercel
.vercel/

# Misc
*.local
